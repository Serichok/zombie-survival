# Local development
SECRET_KEY=replace-with-a-long-random-value
DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
DATABASE_URL=sqlite:///db.sqlite3
# Optional production services
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME
# REDIS_URL=redis://localhost:6379/0
# Optional S3-compatible persistent avatar storage (Cloudflare R2, S3, etc.)
# AWS_STORAGE_BUCKET_NAME=zombie-avatars
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_S3_REGION_NAME=auto
# AWS_S3_ENDPOINT_URL=
JWT_ACCESS_MINUTES=30
TIME_ZONE=Asia/Qyzylorda
LOG_LEVEL=INFO
# Production defaults enable HTTPS redirect and HSTS; override only if TLS is terminated elsewhere incorrectly.
# SECURE_SSL_REDIRECT=true
